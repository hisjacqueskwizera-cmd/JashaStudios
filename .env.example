# Next.js public configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon-key variable is supported only for migration compatibility.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase secret API key. Never expose or commit.
SUPABASE_SECRET_KEY=

# Vision service
VISION_API_URL=http://127.0.0.1:8000
VISION_API_KEY=

# Python service
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Phase 9 is scaffolded but intentionally disabled by default.
TRANSFORMATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_TIMEOUT_SECONDS=240
MAX_REFERENCE_UPLOAD_BYTES=15728640
MAX_REFERENCE_PIXELS=40000000

# Phase 9 worker (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
TRANSFORMATION_WORKER_ID=
TRANSFORMATION_POLL_INTERVAL_SECONDS=3
TRANSFORMATION_JOB_LEASE_SECONDS=300
TRANSFORMATION_MAX_ATTEMPTS=3

# Phase 11 billing
# No payment gateway is configured yet. Keep checkout disabled until a provider adapter
# and verified webhook implementation have been selected and deployed.
PAYMENT_PROVIDER=unconfigured

# Optional infrastructure
DATABASE_URL=
REDIS_URL=
