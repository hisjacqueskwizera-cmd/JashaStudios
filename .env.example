# Next.js public configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon-key variable is supported only for migration compatibility.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase secret key for paired-device uploads. Never expose or commit.
SUPABASE_SECRET_KEY=

# Optional infrastructure
DATABASE_URL=
REDIS_URL=

# Public application origin used for QR pairing and auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

