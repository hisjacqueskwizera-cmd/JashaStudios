# Next.js public configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon-key variable is supported only for migration compatibility.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase secret API key. Never expose or commit.
SUPABASE_SECRET_KEY=

# Python service
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Local open-source image transformation (no paid AI API required).
# Enable only after applying the processing queue migration and configuring the worker.
TRANSFORMATION_ENABLED=false
LOCAL_TRANSFORM_ENABLED=true
MAX_REFERENCE_UPLOAD_BYTES=15728640
MAX_REFERENCE_PIXELS=40000000

# Phase 9 worker (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
TRANSFORMATION_WORKER_ID=
TRANSFORMATION_POLL_INTERVAL_SECONDS=3
TRANSFORMATION_JOB_LEASE_SECONDS=300
TRANSFORMATION_MAX_ATTEMPTS=3

# Optional infrastructure
DATABASE_URL=
REDIS_URL=

# Public application origin used for QR pairing and auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

