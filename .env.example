# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy anon-key variable is supported only for migration compatibility.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase secret API key for paired-phone uploads. Never expose or commit it.
SUPABASE_SECRET_KEY=

VISION_API_URL=http://127.0.0.1:8000
VISION_API_KEY=

# Python service
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Optional infrastructure
DATABASE_URL=
REDIS_URL=
